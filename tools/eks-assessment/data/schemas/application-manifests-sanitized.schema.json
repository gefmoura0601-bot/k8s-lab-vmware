{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assessment.local/schemas/application-manifests-sanitized-4.x.json",
  "type": "object",
  "required": ["schemaVersion", "notice", "items"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^4\\."},
    "notice": {"type": "string", "minLength": 1},
    "items": {"type": "array", "items": {"type": "object", "required": ["apiVersion", "kind", "metadata"], "properties": {"apiVersion": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "metadata": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true}}, "additionalProperties": true}}
  },
  "additionalProperties": true
}
