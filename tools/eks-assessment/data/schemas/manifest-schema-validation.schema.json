{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assessment.local/schemas/manifest-schema-validation-1.0.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "readOnly", "assessmentMode", "state", "summary", "findings", "notice"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "readOnly": {"const": true},
    "assessmentMode": {"const": "OFFLINE_SEMANTIC"},
    "state": {"type": "string", "enum": ["PASS", "WARN", "FAIL", "PARTIAL", "EVIDENCE_UNAVAILABLE"]},
    "summary": {"type": "object", "required": ["manifests", "critical", "warnings"], "properties": {"manifests": {"type": "integer", "minimum": 0}, "critical": {"type": "integer", "minimum": 0}, "warnings": {"type": "integer", "minimum": 0}}, "additionalProperties": true},
    "findings": {"type": "array", "items": {"type": "object"}},
    "notice": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
