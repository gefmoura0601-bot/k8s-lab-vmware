# -*- mode: ruby -*-
# vi: set ft=ruby :

KUBERNETES_MINOR = ENV.fetch("KUBERNETES_MINOR", "v1.35")
CALICO_VERSION = ENV.fetch("CALICO_VERSION", "v3.32.1")
ARGOCD_VERSION = ENV.fetch("ARGOCD_VERSION", "v3.4.2")
ACTIONS_RUNNER_VERSION = "2.334.0"
ACTIONS_RUNNER_SHA256 = "048024cd2c848eb6f14d5646d56c13a4def2ae7ee3ad12122bee960c56f3d271"
ACTIONS_RUNNER_REPOSITORY = "https://github.com/gefmoura0601-bot/k8s-lab-vmware"

NODES = {
  "k8s-master"    => { ip: "192.168.109.151", cpus: 4, mem: 6144, role: "control-plane" },
  "k8s-worker-01" => { ip: "192.168.109.153", cpus: 4, mem: 4096, role: "worker" },
  "k8s-worker-02" => { ip: "192.168.109.155", cpus: 4, mem: 6144, role: "worker" }
}.freeze

Vagrant.configure("2") do |config|
  config.vm.box = "almalinux/9"
  config.vm.box_version = "9.7.20260111"
  config.vm.boot_timeout = 600
  config.ssh.insert_key = true
  config.vm.synced_folder "../..", "/workspace"

  NODES.each do |name, spec|
    config.vm.define name do |node|
      node.vm.hostname = name

      node.vm.provider "vmware_desktop" do |provider|
        provider.gui = false
        provider.vmx["numvcpus"] = spec[:cpus].to_s
        provider.vmx["memsize"] = spec[:mem].to_s
        provider.vmx["ethernet0.present"] = "TRUE"
        provider.vmx["ethernet0.connectiontype"] = "custom"
        provider.vmx["ethernet0.vnet"] = "vmnet8"
        provider.vmx["ethernet1.present"] = "FALSE"
        provider.vmx["ethernet2.present"] = "FALSE"
        provider.vmx["ethernet3.present"] = "FALSE"
      end

      node.vm.provision "network",
        type: "shell",
        path: "scripts/network.sh",
        args: [spec[:ip]],
        run: "always"

      node.vm.provision "shell",
        path: "scripts/common.sh",
        args: [spec[:ip], KUBERNETES_MINOR]

      if spec[:role] == "control-plane"
        node.vm.provision "shell",
          path: "scripts/control-plane.sh",
          args: [spec[:ip], CALICO_VERSION, ARGOCD_VERSION]
        node.vm.provision "actions-runner",
          type: "shell",
          path: "scripts/actions-runner.sh",
          args: [ACTIONS_RUNNER_VERSION, ACTIONS_RUNNER_SHA256, ACTIONS_RUNNER_REPOSITORY, "k8s-master", "master"],
          env: { "ACTIONS_RUNNER_TOKEN" => ENV.fetch("ACTIONS_RUNNER_TOKEN", "") }
      else
        node.vm.provision "shell",
          path: "scripts/worker.sh"
      end
    end
  end
end
